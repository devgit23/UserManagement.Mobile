<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UserManagement.Mobile.Core.ViewModels;assembly=UserManagement.Mobile.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:workforce="clr-namespace:UserManagement.Common.Workforce;assembly=UserManagement.Common"
             xmlns:attendance="clr-namespace:UserManagement.Common.Attendance;assembly=UserManagement.Common"
             x:Class="UserManagement.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Welcome Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding WelcomeMessage}"
                           Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{0:dddd, dd MMMM yyyy}'}"
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Offline Banner -->
                <Border Style="{StaticResource OfflineBanner}"
                        IsVisible="{Binding IsOnline, Converter={StaticResource InvertedBoolConverter}}">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xF05AA;"
                               FontFamily="MaterialDesignIcons" FontSize="18"
                               TextColor="{StaticResource WarningDark}"
                               VerticalOptions="Center" />
                        <Label Text="You are offline. Showing cached data."
                               TextColor="{StaticResource WarningDark}"
                               FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Quick Action Buttons -->
                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                    <!-- Attendance shortcut -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                Stroke="Transparent" StrokeThickness="0"
                                BackgroundColor="{StaticResource SuccessLight}"
                                HorizontalOptions="Center" Padding="0">
                            <Label Text="&#xF0150;"
                                   FontFamily="MaterialDesignIcons" FontSize="24"
                                   TextColor="{StaticResource Success}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Attendance" FontSize="11"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Apply Leave shortcut -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                Stroke="Transparent" StrokeThickness="0"
                                BackgroundColor="{StaticResource InfoLight}"
                                HorizontalOptions="Center" Padding="0">
                            <Label Text="&#xF0E17;"
                                   FontFamily="MaterialDesignIcons" FontSize="24"
                                   TextColor="{StaticResource Info}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Leave" FontSize="11"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Directory shortcut -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                Stroke="Transparent" StrokeThickness="0"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                HorizontalOptions="Center" Padding="0">
                            <Label Text="&#xF0849;"
                                   FontFamily="MaterialDesignIcons" FontSize="24"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Directory" FontSize="11"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Biometric shortcut -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center"
                                         IsVisible="{Binding ShowBiometric}">
                        <Border WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                Stroke="Transparent" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#E8DEF8, Dark=#1A6750A4}"
                                HorizontalOptions="Center" Padding="0">
                            <Label Text="&#xF0A71;"
                                   FontFamily="MaterialDesignIcons" FontSize="24"
                                   TextColor="#6750A4"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Biometric" FontSize="11"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToBiometricCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Stats Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="12" RowSpacing="12">

                    <!-- Present Today -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource SuccessLight}"
                                    HorizontalOptions="Start" Padding="0">
                                <Label Text="&#xF05E0;"
                                       FontFamily="MaterialDesignIcons" FontSize="20"
                                       TextColor="{StaticResource Success}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding PresentToday}" Style="{StaticResource StatNumber}"
                                   TextColor="{StaticResource Success}" />
                            <Label Text="Present Today" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- On Leave -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource WarningLight}"
                                    HorizontalOptions="Start" Padding="0">
                                <Label Text="&#xF0E17;"
                                       FontFamily="MaterialDesignIcons" FontSize="20"
                                       TextColor="{StaticResource Warning}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding OnLeaveToday}" Style="{StaticResource StatNumber}"
                                   TextColor="{StaticResource Warning}" />
                            <Label Text="On Leave" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Total Employees -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource InfoLight}"
                                    HorizontalOptions="Start" Padding="0">
                                <Label Text="&#xF0849;"
                                       FontFamily="MaterialDesignIcons" FontSize="20"
                                       TextColor="{StaticResource Info}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding TotalEmployees}" Style="{StaticResource StatNumber}"
                                   TextColor="{StaticResource Info}" />
                            <Label Text="Total Employees" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Pending Leave -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource DangerLight}"
                                    HorizontalOptions="Start" Padding="0">
                                <Label Text="&#xF0966;"
                                       FontFamily="MaterialDesignIcons" FontSize="20"
                                       TextColor="{StaticResource Danger}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding PendingLeaveRequests}" Style="{StaticResource StatNumber}"
                                   TextColor="{StaticResource Danger}" />
                            <Label Text="Pending Leaves" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Unread Notifications -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Style="{StaticResource CardBorder}"
                            IsVisible="{Binding ShowNotifications}">
                        <HorizontalStackLayout Spacing="14">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    Padding="0">
                                <Label Text="&#xF009C;"
                                       FontFamily="MaterialDesignIcons" FontSize="20"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding UnreadNotifications}" Style="{StaticResource StatNumber}"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="Unread Notifications" Style="{StaticResource StatLabel}" />
                            </VerticalStackLayout>
                            <Label Text="&#xF0142;" FontFamily="MaterialDesignIcons"
                                   FontSize="20" TextColor="{StaticResource Gray300}"
                                   VerticalOptions="Center" HorizontalOptions="End" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- ── Upcoming Holidays ── -->
                <Border Style="{StaticResource CardBorder}"
                        IsVisible="{Binding HasUpcomingHolidays}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xF0ED7;"
                                   FontFamily="MaterialDesignIcons" FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <Label Text="Upcoming Holidays"
                                   FontFamily="OpenSansSemibold" FontSize="15"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <CollectionView ItemsSource="{Binding UpcomingHolidays}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="workforce:HolidayModel">
                                    <Border Margin="0,3" Padding="12,10"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="Transparent" StrokeThickness="0"
                                            BackgroundColor="{StaticResource PrimaryLight}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Grid.Column="0"
                                                                 WidthRequest="44" HeightRequest="44"
                                                                 HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding Date, StringFormat='{0:dd}'}"
                                                       FontFamily="OpenSansSemibold" FontSize="16"
                                                       TextColor="{StaticResource Primary}"
                                                       HorizontalOptions="Center" />
                                                <Label Text="{Binding Date, StringFormat='{0:MMM}'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Primary}"
                                                       HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="OpenSansSemibold" FontSize="14"
                                                       TextColor="{StaticResource Gray600}" />
                                                <Label Text="{Binding Date, StringFormat='{0:dddd}'}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray400}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Region}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray400}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Leave Balances ── -->
                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding HasLeaveBalances}">

                    <!-- Section Header -->
                    <HorizontalStackLayout Spacing="8" Padding="2,0">
                        <Label Text="&#xF0E17;"
                               FontFamily="MaterialDesignIcons" FontSize="20"
                               TextColor="{StaticResource Info}"
                               VerticalOptions="Center" />
                        <Label Text="My Leave Balances"
                               FontFamily="OpenSansSemibold" FontSize="15"
                               TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Horizontal Scrolling Leave Cards -->
                    <CollectionView ItemsSource="{Binding LeaveBalances}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="170">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeaveBalanceDisplayItem">
                                <Border Margin="0,0,12,0" Padding="0"
                                        WidthRequest="160"
                                        StrokeShape="RoundRectangle 14"
                                        Stroke="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding
                                            Light={StaticResource CardSurface},
                                            Dark={StaticResource CardSurfaceDark}}">
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource Black}"
                                                Offset="0,2" Radius="8" Opacity="0.06" />
                                    </Border.Shadow>
                                    <Grid RowDefinitions="6,*">
                                        <!-- Colored top accent strip -->
                                        <BoxView Grid.Row="0"
                                                 Color="{StaticResource Info}"
                                                 HeightRequest="6"
                                                 VerticalOptions="Start" />

                                        <!-- Card content -->
                                        <VerticalStackLayout Grid.Row="1" Padding="14,10,14,14" Spacing="6">
                                            <!-- Leave type with icon -->
                                            <HorizontalStackLayout Spacing="8">
                                                <Border WidthRequest="28" HeightRequest="28"
                                                        StrokeShape="RoundRectangle 14"
                                                        Stroke="Transparent" StrokeThickness="0"
                                                        BackgroundColor="{StaticResource InfoLight}"
                                                        Padding="0">
                                                    <Label Text="&#xF0E17;"
                                                           FontFamily="MaterialDesignIcons" FontSize="13"
                                                           TextColor="{StaticResource Info}"
                                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding LeaveCode}"
                                                       FontFamily="OpenSansSemibold" FontSize="13"
                                                       TextColor="{AppThemeBinding
                                                           Light={StaticResource Gray600},
                                                           Dark={StaticResource Gray200}}"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>

                                            <!-- Big balance number -->
                                            <VerticalStackLayout Spacing="0">
                                                <Label FontSize="11"
                                                       TextColor="{StaticResource Gray400}"
                                                       Text="Available" />
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding BalanceText}"
                                                           FontFamily="OpenSansSemibold" FontSize="28"
                                                           TextColor="{StaticResource Success}" />
                                                    <Label Text="days" FontSize="12"
                                                           TextColor="{StaticResource Gray400}"
                                                           VerticalOptions="End" Margin="0,0,0,5" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Progress bar (used / total) -->
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Border Grid.Row="0" HeightRequest="6"
                                                        StrokeShape="RoundRectangle 3"
                                                        Stroke="Transparent" StrokeThickness="0"
                                                        BackgroundColor="{StaticResource Gray100}"
                                                        Padding="0">
                                                    <ProgressBar Progress="{Binding UsageProgress}"
                                                                 HeightRequest="6"
                                                                 ProgressColor="{StaticResource Info}" />
                                                </Border>
                                                <HorizontalStackLayout Grid.Row="1" Spacing="2">
                                                    <Label FontSize="10" TextColor="{StaticResource Gray400}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding UsedText}" FontFamily="OpenSansSemibold" />
                                                                <Span Text=" used" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label Text=" / " FontSize="10" TextColor="{StaticResource Gray300}" />
                                                    <Label FontSize="10" TextColor="{StaticResource Gray400}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding EntitlementText}" FontFamily="OpenSansSemibold" />
                                                                <Span Text=" total" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <!-- Pending badge -->
                                            <Border StrokeShape="RoundRectangle 8"
                                                    Stroke="Transparent" StrokeThickness="0"
                                                    BackgroundColor="{StaticResource WarningLight}"
                                                    Padding="8,3" HorizontalOptions="Start"
                                                    IsVisible="{Binding HasPending}">
                                                <Label FontSize="10" TextColor="{StaticResource WarningDark}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding PendingText}" FontFamily="OpenSansSemibold" />
                                                            <Span Text=" pending" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Summary Footer -->
                    <Border Style="{StaticResource CardBorder}" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="0">
                            <!-- Available -->
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalAvailableLeave}"
                                       FontFamily="OpenSansSemibold" FontSize="20"
                                       TextColor="{StaticResource Success}"
                                       HorizontalOptions="Center" />
                                <Label Text="Available" FontSize="11"
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Divider -->
                            <BoxView Grid.Column="1" WidthRequest="1"
                                     Color="{StaticResource Gray100}"
                                     VerticalOptions="Fill" Margin="8,0" />

                            <!-- Used -->
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalUsedLeave}"
                                       FontFamily="OpenSansSemibold" FontSize="20"
                                       TextColor="{StaticResource Danger}"
                                       HorizontalOptions="Center" />
                                <Label Text="Used" FontSize="11"
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Divider -->
                            <BoxView Grid.Column="3" WidthRequest="1"
                                     Color="{StaticResource Gray100}"
                                     VerticalOptions="Fill" Margin="8,0"
                                     IsVisible="{Binding HasPendingLeave}" />

                            <!-- Pending -->
                            <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="2"
                                                 IsVisible="{Binding HasPendingLeave}">
                                <Label Text="{Binding TotalPendingLeave}"
                                       FontFamily="OpenSansSemibold" FontSize="20"
                                       TextColor="{StaticResource Warning}"
                                       HorizontalOptions="Center" />
                                <Label Text="Pending" FontSize="11"
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Attendance Summary ── -->
                <Border Style="{StaticResource CardBorder}"
                        IsVisible="{Binding HasAttendanceStats}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xF0150;"
                                   FontFamily="MaterialDesignIcons" FontSize="20"
                                   TextColor="{StaticResource Success}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Attendance Summary"
                                       FontFamily="OpenSansSemibold" FontSize="15"
                                       TextColor="{StaticResource Gray600}" />
                                <Label Text="{Binding AttendancePeriod}"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray400}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="10" RowSpacing="10">

                            <!-- Days Present -->
                            <Border Grid.Row="0" Grid.Column="0" Padding="12,10"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource SuccessLight}">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding DaysPresent}"
                                           FontFamily="OpenSansSemibold" FontSize="22"
                                           TextColor="{StaticResource Success}"
                                           HorizontalOptions="Center" />
                                    <Label Text="Present" FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Days Absent -->
                            <Border Grid.Row="0" Grid.Column="1" Padding="12,10"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource DangerLight}">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding DaysAbsent}"
                                           FontFamily="OpenSansSemibold" FontSize="22"
                                           TextColor="{StaticResource Danger}"
                                           HorizontalOptions="Center" />
                                    <Label Text="Absent" FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- On-Time % -->
                            <Border Grid.Row="1" Grid.Column="0" Padding="12,10"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource InfoLight}">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label FontFamily="OpenSansSemibold" FontSize="22"
                                           TextColor="{StaticResource Info}"
                                           HorizontalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding OnTimePercent}" />
                                                <Span Text="%" FontSize="14" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="On-Time" FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Avg Hours -->
                            <Border Grid.Row="1" Grid.Column="1" Padding="12,10"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent" StrokeThickness="0"
                                    BackgroundColor="{StaticResource WarningLight}">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label FontFamily="OpenSansSemibold" FontSize="22"
                                           TextColor="{StaticResource Warning}"
                                           HorizontalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding AvgHours}" />
                                                <Span Text="h" FontSize="14" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Avg Hours" FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}" />

                <!-- Error -->
                <Border Style="{StaticResource BadgeDanger}" Padding="14,10"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="&#xF05D6;" FontFamily="MaterialDesignIcons"
                               FontSize="18" TextColor="{StaticResource Danger}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Danger}" FontSize="13"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
