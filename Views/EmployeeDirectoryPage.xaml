<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UserManagement.Mobile.Core.ViewModels;assembly=UserManagement.Mobile.Core"
             x:Class="UserManagement.Mobile.Views.EmployeeDirectoryPage"
             x:DataType="vm:EmployeeDirectoryViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <!-- Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource InputBorder}"
                Margin="12,10" Padding="4,0,12,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Grid.Column="0" Text="&#xF0349;"
                       FontFamily="MaterialDesignIcons" FontSize="22"
                       TextColor="{StaticResource Gray400}"
                       VerticalOptions="Center" Margin="8,0,0,0" />
                <SearchBar Grid.Column="1"
                           Placeholder="Search employees..."
                           Text="{Binding SearchQuery}"
                           SearchCommand="{Binding SearchCommand}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Employees}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:EmployeeListItem">
                        <Border Style="{StaticResource CardBorderCompact}" Margin="12,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- Avatar -->
                                <Border Grid.Column="0" Style="{StaticResource AvatarBorder}">
                                    <Label Text="{Binding FullName, Converter={StaticResource FirstCharConverter}}"
                                           FontSize="18" FontFamily="OpenSansSemibold"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                </Border>

                                <!-- Name and details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding FullName}" Style="{StaticResource CardTitle}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="&#xF0814;"
                                               FontFamily="MaterialDesignIcons" FontSize="12"
                                               TextColor="{StaticResource Gray400}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Designation}" FontSize="12"
                                               TextColor="{StaticResource Gray500}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="&#xF0990;"
                                               FontFamily="MaterialDesignIcons" FontSize="12"
                                               TextColor="{StaticResource Gray400}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Department}" FontSize="11"
                                               TextColor="{StaticResource Gray400}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Chevron -->
                                <Label Grid.Column="2" Text="&#xF0142;"
                                       FontFamily="MaterialDesignIcons" FontSize="20"
                                       TextColor="{StaticResource Gray300}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" Margin="0,40">
                        <Label Text="&#xF0849;" FontFamily="MaterialDesignIcons"
                               FontSize="40" TextColor="{StaticResource Gray300}"
                               HorizontalOptions="Center" />
                        <Label Text="No employees found" Style="{StaticResource EmptyStateLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Error -->
        <Border Grid.Row="1" Style="{StaticResource BadgeDanger}" Padding="14,10"
                VerticalOptions="End" Margin="16,0,16,8"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="&#xF05D6;" FontFamily="MaterialDesignIcons"
                       FontSize="18" TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                       FontSize="13" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
